VITE_APP_BASE_URL=
VITE_APP_USERNAME=
VITE_APP_PASSWORD=

VITE_REVERB_APP_KEY=
VITE_REVERB_SCHEME=
VITE_REVERB_HOST=
VITE_REVERB_AUTH_URL=
VITE_REVERB_PORT=

VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_PUSHER_APP_CLUSTER=

VITE_DEV_SERVER_HOST=
VITE_DEV_SERVER_HTTPS=

VITE_AUTH_CHANNEL=EMAIL# BOTH, MOBILE_NUMBER, EMAIL, defaults to EMAIL
# Hotels and the rest of travel are licensed per deployment. Set to "false" on a
# deployment without the licence, where every travel route answers 404.
VITE_TRAVEL_ENABLED=true

VITE_VOLUME_PAYMENT_MERCHANT_ID=
# Which Volume to open — SANDBOX or PRODUCTION. Defaults to SANDBOX when unset,
# so a deployment that forgets it takes no money rather than the wrong money.
# Only travel reads this; the transfer components still hardcode SANDBOX.
VITE_VOLUME_PAYMENT_ENVIRONMENT=SANDBOX
