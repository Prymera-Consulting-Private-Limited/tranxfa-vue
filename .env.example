# Every VITE_ variable is inlined into the public bundle at build time. Nothing
# here may be a secret. The Reverb/Pusher app keys are public identifiers.

# --- App -------------------------------------------------------------------
VITE_APP_BASE_URL=
# local selects the Reverb websocket config and the ngrok header; anything
# else uses Pusher.
VITE_APP_ENV=production
# Shown in page titles and the not-found page.
VITE_APP_NAME=RemitSo
# Public URL of this app, used for links the API sends back to it.
VITE_APP_URL=
# Optional. A brand build may set this to send Accept-Language on every API
# request (the SalvTech build uses "es"). Unset means the API default.
# VITE_APP_LOCALE=

# --- Realtime ---------------------------------------------------------------
VITE_REVERB_APP_KEY=
VITE_REVERB_SCHEME=
VITE_REVERB_HOST=
VITE_REVERB_AUTH_URL=
VITE_REVERB_PORT=

VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_PUSHER_APP_CLUSTER=

# --- Onboarding -------------------------------------------------------------
VITE_AUTH_CHANNEL=EMAIL# BOTH, MOBILE_NUMBER, EMAIL, defaults to EMAIL

# Which optional steps onboarding includes. Defaults preserve current
# behaviour, so an unset value changes nothing.
VITE_ONBOARDING_COLLECT_ADDRESS=true            # ask for a residential address during onboarding
VITE_ONBOARDING_VERIFY_MOBILE_NUMBER=false      # email-first only; verify the number with an OTP

# Sentences the customer ticks at sign-up and before confirming a transfer.
# Leaving them empty hides the checkbox, and the API then rejects the request.
VITE_THIRD_PARTY_SIGNUP_DECLARATION="I confirm I am not acting on behalf of a third party."
VITE_THIRD_PARTY_TRANSACTION_DECLARATION="I confirm this transfer is not on behalf of a third party."

# --- Legal ------------------------------------------------------------------
VITE_PRIVACY_POLICY_URL=
VITE_USER_AGREEMENT_URL=

# --- Third parties ----------------------------------------------------------
# Value-added products are not configured here. The installation's licence
# decides: GET /client/v1/service-status carries value_added_services, which is
# read on every launch (SD-1074). VITE_HOTELS_ENABLED, VITE_FLIGHTS_ENABLED,
# VITE_WALLET_ENABLED, VITE_COUPONS_ENABLED and VITE_TRAVEL_ENABLED are gone;
# an installation that still sets one is setting nothing.
#
# Whether the maintenance-window banner renders. The call itself always runs,
# because the licence rides on it; this decides only whether the banner shows.
VITE_SERVICE_STATUS_ENABLED=false

VITE_VOLUME_PAYMENT_MERCHANT_ID=
# Which Volume to open: SANDBOX or PRODUCTION. A production build with this
# unset renders the payment as unavailable instead of falling back to sandbox;
# development builds fall back to SANDBOX.
VITE_VOLUME_PAYMENT_ENVIRONMENT=SANDBOX
